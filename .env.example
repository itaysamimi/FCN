# כתובת הפרויקט ב-Supabase: Project Settings > API > Project URL
NEXT_PUBLIC_SUPABASE_URL=

# המפתח הציבורי (anon) של Supabase: Project Settings > API > Project API keys > anon public
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# מפתח service role של Supabase (סודי, לשרת בלבד!): Project Settings > API > Project API keys > service_role
SUPABASE_SERVICE_ROLE_KEY=

# מזהה החשבון ב-Cloudflare: לוח הבקרה של Cloudflare > R2 > Account ID (בצד ימין של עמוד הסקירה)
R2_ACCOUNT_ID=

# מזהה מפתח הגישה ל-R2: Cloudflare > R2 > Manage R2 API Tokens > Create API token
R2_ACCESS_KEY_ID=

# המפתח הסודי של R2 (מוצג פעם אחת בלבד ביצירת הטוקן, לשרת בלבד!)
R2_SECRET_ACCESS_KEY=

# שם ה-bucket שיצרת ב-Cloudflare > R2
R2_BUCKET_NAME=

# סוד שמגן על ה-route של ה-Cron. מחרוזת אקראית ארוכה, למשל: openssl rand -hex 32
CRON_SECRET=
